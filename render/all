#!/bin/bash
#
# Run this to re-render every .md in this repo to its corresponding .pdf.

set -eu -o pipefail
RUNNER="$(type -p docker || type -p podman)"

# Explicitly pull the container to avoid having dozens of parallel
# ./go processes fighting with each other to all pull the same image.
$RUNNER pull --quiet "$(head -1 $(dirname "$0")/.container)" > /dev/null # Must match ./go! 

export RENDER_GO_EMIT_TIMESTAMPS=1 # Read in ./go.

git ls-files '**/*.md' | \
    grep -vE '(README.md|/archived/)' | \
    tr '\012' '\000' | \
    `# Pipe to sort, and rely on ./go emitting less than PIPE_BUF (4096) bytes in a single write(2) to avoid interleaving` \
    xargs -0 -L1 -P0 sh -c 'printf "%s\n" "$(./render/go "$1")"' _ | sort -n
